# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# NUNCA comite o arquivo ".env" no Git.

# Token novo da Hugging Face (gere um novo em https://huggingface.co/settings/tokens
# depois de revogar o antigo que estava exposto no código)
HF_TOKEN=meu_token_IA

# Modelo usado via router da Hugging Face
PAPELIA_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# Quantas perguntas o PapelIA faz antes de dar o diagnóstico
PAPELIA_NUM_PERGUNTAS=3

PAPELIA_TEMPERATURE=0.3
PAPELIA_MAX_TOKENS=1024

# Em produção, troque "*" pelo domínio real do seu frontend
PAPELIA_CORS_ORIGINS=*
